# Append these settings to .env.local; never overwrite an existing secret with the examples.
STRIPE_SECRET_KEY=sk_test_replace_with_your_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_this_endpoint_signing_secret
SITE_URL=http://127.0.0.1:3001
PAY_ALLOW_TEST=1
PAY_TOPRO_SECRET=replace_with_a_random_secret_at_least_32_characters
PAY_TOPRO_ORIGIN=http://127.0.0.1:3200
# Local Node API creates .wrangler/unified-payments.sqlite automatically.
# Production requires a Cloudflare D1 binding named PAYMENTS_DB.
